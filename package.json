{
  "name": "metaCat-dashboard",
  "version": "1.0.0",
  "engines": {
    "node": ">=24.7.0"
  },
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:api": "cd ../metacat-api && uv run uvicorn metacat_api.main:app --reload",
    "dev:all": "concurrently -k -n \"NEXT,API\" -c \"cyan,magenta\" \"npm:dev\" \"npm:dev:api\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint . --fix",
    "docker": "docker build -t next . && docker run -p 3000:3000 next",
    "test": "vitest --project rtl",
    "test:coverage": "vitest --project rtl --coverage"
  },
  "dependencies": {
    "@nivo/bar": "^0.99.0",
    "@nivo/core": "^0.99.0",
    "@nivo/heatmap": "^0.99.0",
    "@nivo/line": "^0.99.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "axios": "^1.15.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "i18next": "^26.0.4",
    "next": "^16.2.3",
    "next-i18next": "^16.0.5",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.26",
    "react": "19.2.5",
    "react-aria-components": "^1.20.0",
    "react-dom": "19.2.5",
    "react-i18next": "^17.0.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.2"
  }
}